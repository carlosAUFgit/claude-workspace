#!/usr/bin/env bash
# /etc/libvirt/hooks/qemu — installed by 05-install-hooks.sh
#
# Dynamic host tuning around the VM lifecycle. This does what isolcpus does,
# except only while the VM is actually running:
#
#   * evacuates host processes off the vCPUs the guest is pinned to
#   * pins host IRQ handling away from those cores
#   * switches the CPU governor to performance
#
# All of it is undone when the VM stops, so the machine is a normal desktop
# with all its cores back the rest of the time. Every change uses systemd's
# --runtime flag, so a reboot also clears it even if a hook fails to fire.
#
# libvirt calls: $1=domain $2=operation $3=sub-operation, guest XML on stdin.

set -uo pipefail

DOMAIN=$1
OPERATION=$2
STATE_FILE=/run/libvirt-hook-${DOMAIN}.state
LOG_TAG="libvirt-hook[$DOMAIN]"

log() { logger -t "$LOG_TAG" -- "$*"; printf '%s\n' "$*" >&2; }

all_cpus="0-$(( $(nproc) - 1 ))"

# --- helpers --------------------------------------------------------------

expand_list() {
  local part start end out=()
  IFS=',' read -ra parts <<<"$1"
  for part in "${parts[@]}"; do
    if [[ $part == *-* ]]; then
      start=${part%-*}; end=${part#*-}
      for ((i = start; i <= end; i++)); do out+=("$i"); done
    else
      out+=("$part")
    fi
  done
  printf '%s\n' "${out[@]}"
}

set_governor() {
  local gov=$1 n=0
  for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [[ -w $g ]] || continue
    if grep -qw "$gov" "${g%scaling_governor}scaling_available_governors" 2>/dev/null; then
      printf '%s' "$gov" >"$g" 2>/dev/null && n=$((n + 1))
    fi
  done
  [[ $n -gt 0 ]] && log "governor -> $gov on $n CPUs"
}

# Confine the host's own workload to the cores the guest is not using.
# system.slice/user.slice/init.scope covers essentially every host process.
confine_host() {
  local cpus=$1
  for unit in system.slice user.slice init.scope; do
    systemctl set-property --runtime -- "$unit" "AllowedCPUs=$cpus" 2>/dev/null \
      || log "warning: could not set AllowedCPUs on $unit"
  done
  log "host processes confined to CPUs $cpus"
}

release_host() {
  for unit in system.slice user.slice init.scope; do
    systemctl set-property --runtime -- "$unit" "AllowedCPUs=$all_cpus" 2>/dev/null || true
  done
  log "host processes released to CPUs $all_cpus"
}

# Move interrupt handling off the guest's cores. Devices that only support a
# single CPU affinity, and per-CPU interrupts, reject the write; that is
# expected and harmless, so failures are ignored per-IRQ.
steer_irqs() {
  local mask_cpus=$1 moved=0
  # irqbalance would immediately undo this, so pause it for the duration.
  if systemctl is-active --quiet irqbalance; then
    systemctl stop irqbalance && touch "${STATE_FILE}.irqbalance"
    log "stopped irqbalance"
  fi
  for irq in /proc/irq/[0-9]*; do
    [[ -w $irq/smp_affinity_list ]] || continue
    printf '%s' "$mask_cpus" >"$irq/smp_affinity_list" 2>/dev/null && moved=$((moved + 1))
  done
  log "steered $moved IRQs to CPUs $mask_cpus"
}

restore_irqs() {
  for irq in /proc/irq/[0-9]*; do
    [[ -w $irq/smp_affinity_list ]] || continue
    printf '%s' "$all_cpus" >"$irq/smp_affinity_list" 2>/dev/null || true
  done
  if [[ -e ${STATE_FILE}.irqbalance ]]; then
    systemctl start irqbalance 2>/dev/null || true
    rm -f "${STATE_FILE}.irqbalance"
    log "restarted irqbalance"
  fi
  log "IRQ affinity restored"
}

# --- main -----------------------------------------------------------------

case "$OPERATION" in
  prepare)
    # Guest XML arrives on stdin.
    #
    # Only <vcpupin> cpusets get exclusive treatment. <emulatorpin> and
    # <iothreadpin> deliberately point at the housekeeping cores, so folding
    # them in here would strand the emulator thread on cores we then evacuate.
    xml=$(cat)
    mapfile -t vcpu_only < <(grep -o "<vcpupin[^>]*cpuset='[^']*'" <<<"$xml" \
      | sed "s/.*cpuset='//;s/'//" \
      | while read -r l; do expand_list "$l"; done | sort -n -u)

    if [[ ${#vcpu_only[@]} -eq 0 ]]; then
      log "no CPU pinning in this domain; skipping isolation"
      set_governor performance
      exit 0
    fi

    declare -A is_guest
    for c in "${vcpu_only[@]}"; do is_guest[$c]=1; done
    host_cpus=()
    for ((c = 0; c < $(nproc); c++)); do
      [[ -n ${is_guest[$c]:-} ]] || host_cpus+=("$c")
    done

    if [[ ${#host_cpus[@]} -eq 0 ]]; then
      log "refusing to isolate: the guest is pinned to every CPU"
      set_governor performance
      exit 0
    fi

    host_list=$(IFS=,; printf '%s' "${host_cpus[*]}")
    printf '%s\n' "$host_list" >"$STATE_FILE"

    log "guest CPUs: $(IFS=,; printf '%s' "${vcpu_only[*]}") | host CPUs: $host_list"
    confine_host "$host_list"
    steer_irqs "$host_list"
    set_governor performance
    ;;

  release)
    release_host
    restore_irqs
    # schedutil is the sane desktop default on CachyOS' amd_pstate setups;
    # fall back to whatever is available if it is not.
    if grep -q schedutil /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors 2>/dev/null; then
      set_governor schedutil
    else
      set_governor powersave
    fi
    rm -f "$STATE_FILE"
    ;;
esac

exit 0
