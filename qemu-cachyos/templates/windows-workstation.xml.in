<!--
  Tuned libvirt domain for a Windows CAD/compute guest (SolidWorks, MATLAB)
  on an AMD host with a passed-through GPU.

  This is a template. 04-create-windows-vm.sh substitutes the placeholders
  (written as a name between at-signs) with values detected from your
  hardware. Do not edit them by hand unless you are generating the domain
  yourself; rendering fails loudly if any placeholder is left unresolved.

  Every non-obvious choice is commented, because the difference between a
  VM that feels native and one that stutters is almost entirely in this file.
-->
<domain type='kvm'>
  <name>@VM_NAME@</name>
  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://microsoft.com/win/11"/>
    </libosinfo:libosinfo>
  </metadata>

  <memory unit='KiB'>@MEM_KIB@</memory>
  <currentMemory unit='KiB'>@MEM_KIB@</currentMemory>

  <memoryBacking>
    <!-- 1 GiB pages: fewer page-table levels to walk, far fewer TLB misses.
         Matters most for MATLAB's large working sets. -->
    <hugepages>
      <page size='1048576' unit='KiB'/>
    </hugepages>
    <!-- KSM page merging scans and dedupes guest memory. With one big VM it
         only burns host CPU, and it is a documented side-channel surface. -->
    <nosharepages/>
    <!-- VFIO pins everything anyway; make it explicit so nothing tries to
         swap guest pages out from under a DMA-capable device. -->
    <locked/>
    <allocation mode='immediate'/>
  </memoryBacking>

  <vcpu placement='static'>@VCPUS@</vcpu>

  <!-- Dedicated I/O threads keep disk completion work off the vCPUs, so a
       burst of disk traffic cannot stall the thread SolidWorks is modelling on. -->
  <iothreads>2</iothreads>

  <cputune>
@VCPUPIN@
    <!-- The emulator and I/O threads live on host cores the guest does NOT
         use. Sharing them with a vCPU is a classic cause of micro-stutter. -->
    <emulatorpin cpuset='@HOUSEKEEPING@'/>
    <iothreadpin iothread='1' cpuset='@HOUSEKEEPING@'/>
    <iothreadpin iothread='2' cpuset='@HOUSEKEEPING@'/>
  </cputune>

  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <!-- q35 + UEFI is required for PCIe passthrough to present the GPU as a
         real PCIe device, and for Windows 11's firmware requirements.
         Explicit loader paths rather than firmware='efi' autoselection: the
         autoselector picks by feature matching and can quietly land on a
         non-Secure-Boot build, which Windows 11 setup then rejects. -->
    <loader readonly='yes' secure='@SECURE@' type='pflash'>@OVMF_CODE@</loader>
    <nvram template='@OVMF_VARS@'>/var/lib/libvirt/qemu/nvram/@VM_NAME@_VARS.fd</nvram>
    <boot dev='hd'/>
    <bootmenu enable='yes'/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <!-- Hyper-V enlightenments. Without these, Windows falls back to
         spinning on locks and polling timers, and burns host CPU doing
         nothing. This block alone is worth double-digit percent on an
         idle-to-moderate Windows guest. -->
    <hyperv mode='custom'>
      <relaxed state='on'/>          <!-- stop Windows' watchdog panicking on host scheduling delays -->
      <vapic state='on'/>            <!-- paravirtual APIC: far cheaper interrupt delivery -->
      <spinlocks state='on' retries='8191'/>  <!-- tell Windows to yield instead of spinning forever -->
      <vpindex state='on'/>
      <runtime state='on'/>
      <synic state='on'/>            <!-- synthetic interrupt controller -->
      <stimer state='on'>
        <direct state='on'/>         <!-- synthetic timers without a hypervisor round trip -->
      </stimer>
      <reset state='on'/>
      <frequencies state='on'/>
      <reenlightenment state='on'/>
      <tlbflush state='on'/>         <!-- batch TLB shootdowns instead of one IPI each -->
      <ipi state='on'/>              <!-- paravirtual inter-processor interrupts -->
      <!-- A vendor id only matters for old NVIDIA consumer-driver checks
           (the "Error 43" era). Harmless to keep. -->
      <vendor_id state='on' value='@HV_VENDOR@'/>
    </hyperv>
    <!-- Hide the KVM signature. Modern NVIDIA drivers no longer care, but
         some ISV licensing and anti-tamper layers still sniff for it. -->
    <kvm>
      <hidden state='on'/>
    </kvm>
    <vmport state='off'/>
    <smm state='on'/>
    <ioapic driver='kvm'/>
  </features>

  <!-- host-passthrough exposes the real CPU: AVX2/AVX-512, FMA, and the
       actual cache sizes. MATLAB's BLAS dispatches on CPUID at startup, so a
       generic model silently drops it to a slower kernel. -->
  <cpu mode='host-passthrough' check='none' migratable='off'>
    <topology sockets='1' dies='1' cores='@CORES@' threads='@THREADS@'/>
    <!-- Report the host's real cache hierarchy so the Windows scheduler
         understands which vCPUs share L3 and keeps related threads together. -->
    <cache mode='passthrough'/>
    <!-- topoext is what makes AMD SMT visible to the guest. Without it
         Windows sees @VCPUS@ separate sockets and schedules terribly. -->
    <feature policy='require' name='topoext'/>
    <feature policy='require' name='invtsc'/>
  </cpu>

  <clock offset='localtime'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <!-- HPET is slow and Windows does not need it once hypervclock exists. -->
    <timer name='hpet' present='no'/>
    <timer name='hypervclock' present='yes'/>
    <timer name='tsc' present='yes' mode='native'/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>

  <pm>
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <!-- System disk: raw beats qcow2 for sustained write throughput.
         cache='none' uses O_DIRECT so the host page cache does not double-buffer
         (which would waste RAM and lie to the guest about durability).
         io='io_uring' is the modern async path, cheaper than 'native' AIO. -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='@DISK_FORMAT@' cache='none' io='io_uring'
              discard='unmap' detect_zeroes='unmap' iothread='1' queues='4'/>
      <source file='@DISK_PATH@'/>
      <target dev='vda' bus='virtio'/>
    </disk>

    <!-- Windows install media -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='@WINDOWS_ISO@'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
      <boot order='1'/>
    </disk>

    <!-- virtio driver media. Windows setup will not see the virtio system
         disk until you load the driver from here ("Load driver" ->
         viostor\w11\amd64). Leave it attached for the guest-agent install too. -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='@VIRTIO_ISO@'/>
      <target dev='sdb' bus='sata'/>
      <readonly/>
    </disk>

    <controller type='usb' index='0' model='qemu-xhci' ports='15'/>
    <controller type='pci' index='0' model='pcie-root'/>

    <!-- Windows 11 requires TPM 2.0. swtpm provides it in software. -->
    <tpm model='tpm-crb'>
      <backend type='emulator' version='2.0'/>
    </tpm>

    <interface type='network'>
      <source network='default'/>
      <model type='virtio'/>
      <!-- Multiqueue: one queue per vCPU pair so network softirq work spreads
           instead of bottlenecking one vCPU. -->
      <driver name='vhost' queues='4'/>
      <!-- A stable MAC matters: SolidWorks and MATLAB node-locked licences
           are commonly tied to it. Changing it can invalidate activation. -->
      <mac address='@MAC_ADDR@'/>
    </interface>

    <!-- The passed-through GPU and its companion functions. -->
@HOSTDEVS@

    <!-- A virtual display is kept alongside the real GPU so you always have a
         way into the machine, including before the GPU drivers are installed
         and if the passthrough ever misbehaves. -->
    <graphics type='spice' autoport='yes'>
      <listen type='address' address='127.0.0.1'/>
      <image compression='off'/>
      <gl enable='no'/>
    </graphics>
    <video>
      <model type='virtio' heads='1' primary='yes'/>
    </video>

    <!-- Guest agent: clean shutdowns, filesystem freeze for snapshots. -->
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>
    <channel type='spicevmc'>
      <target type='virtio' name='com.redhat.spice.0'/>
    </channel>

    <input type='tablet' bus='usb'/>
    <input type='mouse' bus='ps2'/>
    <input type='keyboard' bus='ps2'/>

    <sound model='ich9'>
      <audio id='1'/>
    </sound>
    <audio id='1' type='@AUDIO_BACKEND@'/>

    <!-- Balloon off: it fights <locked/> hugepages and VFIO pinning, and
         reclaiming pages from a CAD workload is counterproductive anyway. -->
    <memballoon model='none'/>

    <!-- Report guest kernel panics to the host log instead of a silent hang. -->
    <panic model='hyperv'/>

    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
  </devices>
</domain>
